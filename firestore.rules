rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'targetBench', 'targetSquat', 'targetDeadlift', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!data.keys().hasAny(['targetBench']) || data.targetBench is number) &&
        (!data.keys().hasAny(['targetSquat']) || data.targetSquat is number) &&
        (!data.keys().hasAny(['targetDeadlift']) || data.targetDeadlift is number) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string);
    }

    function isValidWorkout(data) {
      return data.keys().hasAll(['workoutId', 'userId', 'date', 'exercises']) &&
        data.keys().hasOnly(['workoutId', 'userId', 'date', 'exercises', 'notes', 'duration', 'createdAt']) &&
        data.workoutId is string && data.workoutId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.date is string && data.date.size() <= 64 &&
        data.exercises is list && data.exercises.size() <= 50 &&
        (!data.keys().hasAny(['notes']) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!data.keys().hasAny(['duration']) || data.duration is number) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string);
    }

    function isValidCustomExercise(data) {
      return data.keys().hasAll(['exerciseId', 'userId', 'name', 'muscleGroup']) &&
        data.keys().hasOnly(['exerciseId', 'userId', 'name', 'muscleGroup', 'description', 'createdAt']) &&
        data.exerciseId is string && data.exerciseId.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.name is string && data.name.size() <= 128 &&
        data.muscleGroup is string && data.muscleGroup.size() <= 64 &&
        (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500)) &&
        (!data.keys().hasAny(['createdAt']) || data.createdAt is string);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data) && request.resource.data.uid == resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'targetBench', 'targetSquat', 'targetDeadlift']);
      allow delete: if isOwner(userId);
    }

    match /workouts/{workoutId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidWorkout(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidWorkout(request.resource.data) && request.resource.data.userId == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'exercises', 'notes', 'duration']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /customExercises/{exerciseId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidCustomExercise(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidCustomExercise(request.resource.data) && request.resource.data.userId == resource.data.userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'muscleGroup', 'description']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
