rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'targetBench',
          'targetSquat',
          'targetDeadlift',
          'weightUnit',
          'bodyweightKg',
          'languageCode',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() <= 256 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!data.keys().hasAny(['targetBench']) || (data.targetBench is number && data.targetBench > 0)) &&
        (!data.keys().hasAny(['targetSquat']) || (data.targetSquat is number && data.targetSquat > 0)) &&
        (!data.keys().hasAny(['targetDeadlift']) || (data.targetDeadlift is number && data.targetDeadlift > 0)) &&
        (!data.keys().hasAny(['weightUnit']) || data.weightUnit in ['kg', 'lbs']) &&
        (!data.keys().hasAny(['bodyweightKg']) || (data.bodyweightKg is number && data.bodyweightKg >= 20 && data.bodyweightKg <= 400)) &&
        (!data.keys().hasAny(['languageCode']) || (data.languageCode is string && data.languageCode.size() <= 16)) &&
        (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidWorkoutLog(log) {
      return log is map &&
        log.keys().hasAll([
          'id',
          'sessionId',
          'sessionTitle',
          'target1RM',
          'unit',
          'timestamp',
          'totalDurationSeconds',
          'isCompleted'
        ]) &&
        log.keys().hasOnly([
          'id',
          'sessionId',
          'sessionTitle',
          'target1RM',
          'unit',
          'timestamp',
          'totalDurationSeconds',
          'isCompleted'
        ]) &&
        log.id is number &&
        log.sessionId is number &&
        log.sessionTitle is string && log.sessionTitle.size() <= 200 &&
        log.target1RM is number &&
        log.unit in ['kg', 'lbs'] &&
        log.timestamp is number &&
        log.totalDurationSeconds is number &&
        log.isCompleted is bool;
    }

    function isValidWorkout(data) {
      return data.keys().hasAll(['userId', 'workoutLog', 'sets']) &&
        data.keys().hasOnly(['userId', 'workoutLog', 'sets']) &&
        isValidId(data.userId) &&
        isValidWorkoutLog(data.workoutLog) &&
        data.sets is list && data.sets.size() <= 200 &&
        (data.sets.size() == 0 || data.sets[0] is map);
    }

    function isValidCustomExercise(data) {
      return data.keys().hasAll(['exerciseId', 'userId', 'name', 'muscleGroup']) &&
        data.keys().hasOnly(['exerciseId', 'userId', 'name', 'muscleGroup', 'description', 'createdAt']) &&
        isValidId(data.exerciseId) &&
        isValidId(data.userId) &&
        data.name is string && data.name.size() <= 128 &&
        data.muscleGroup is string && data.muscleGroup.size() <= 64 &&
        (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 500)) &&
        (!data.keys().hasAny(['createdAt']) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['uid', 'updatedAt']) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'bodyweightKg',
          'bestBench',
          'bestSquat',
          'bestDeadlift',
          'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.updatedAt is string && data.updatedAt.size() <= 64 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512)) &&
        (!data.keys().hasAny(['bodyweightKg']) || (data.bodyweightKg is number && data.bodyweightKg >= 20 && data.bodyweightKg <= 400)) &&
        (!data.keys().hasAny(['bestBench']) || (data.bestBench is number && data.bestBench >= 0)) &&
        (!data.keys().hasAny(['bestSquat']) || (data.bestSquat is number && data.bestSquat >= 0)) &&
        (!data.keys().hasAny(['bestDeadlift']) || (data.bestDeadlift is number && data.bestDeadlift >= 0));
    }

    function isValidActivity(data) {
      return data.keys().hasAll(['id', 'uid', 'message', 'timestamp']) &&
        data.keys().hasOnly([
          'id',
          'uid',
          'displayName',
          'photoURL',
          'message',
          'timestamp'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.uid) &&
        data.message is string && data.message.size() > 0 && data.message.size() <= 300 &&
        data.timestamp is number && data.timestamp > 0 &&
        (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!data.keys().hasAny(['photoURL']) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'targetBench',
          'targetSquat',
          'targetDeadlift',
          'weightUnit',
          'bodyweightKg',
          'languageCode',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /workouts/{workoutId} {
      allow get: if isValidId(workoutId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(workoutId) &&
        isSignedIn() &&
        isValidWorkout(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if isValidId(workoutId) &&
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        isValidWorkout(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['workoutLog', 'sets']);
      allow delete: if isValidId(workoutId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    match /customExercises/{exerciseId} {
      allow get: if isValidId(exerciseId) && isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isValidId(exerciseId) &&
        isSignedIn() &&
        isValidCustomExercise(incoming()) &&
        incoming().userId == request.auth.uid;
      allow update: if isValidId(exerciseId) &&
        isSignedIn() &&
        existing().userId == request.auth.uid &&
        isValidCustomExercise(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'muscleGroup', 'description']);
      allow delete: if isValidId(exerciseId) && isSignedIn() && existing().userId == request.auth.uid;
    }

    match /publicProfiles/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidPublicProfile(incoming()) &&
        incoming().uid == userId;
      allow delete: if isValidId(userId) && isSignedIn() && request.auth.uid == userId;
    }

    match /activities/{activityId} {
      allow get, list: if isSignedIn();
      allow create: if isValidId(activityId) &&
        isSignedIn() &&
        isValidActivity(incoming()) &&
        incoming().id == activityId &&
        incoming().uid == request.auth.uid;
      allow update: if false;
      allow delete: if isValidId(activityId) && isSignedIn() && existing().uid == request.auth.uid;
    }
  }
}
