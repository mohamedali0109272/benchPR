{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile, training preferences, and target PRs",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "targetBench": { "type": "number" },
        "targetSquat": { "type": "number" },
        "targetDeadlift": { "type": "number" },
        "weightUnit": { "type": "string", "enum": ["kg", "lbs"] },
        "bodyweightKg": { "type": "number" },
        "languageCode": { "type": "string", "maxLength": 16 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Workout": {
      "title": "Workout",
      "description": "Logged workout sessions with exercises and sets",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "workoutLog": { "type": "object" },
        "sets": { "type": "array" }
      },
      "required": ["userId", "workoutLog", "sets"]
    },
    "CustomExercise": {
      "title": "CustomExercise",
      "description": "Custom exercises added by user",
      "type": "object",
      "properties": {
        "exerciseId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 128 },
        "muscleGroup": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["exerciseId", "userId", "name", "muscleGroup"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile and preferences data"
    },
    "/workouts/{workoutId}": {
      "schema": { "$ref": "Workout" },
      "description": "User workouts collection"
    },
    "/customExercises/{exerciseId}": {
      "schema": { "$ref": "CustomExercise" },
      "description": "User custom exercises collection"
    }
  }
}
